{
  "name": "bun-elysia-nextjs-starter",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '@starter/api' --filter '@starter/web' dev",
    "build": "bun run --filter '@starter/web' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '@starter/api' test",
    "db:up": "docker compose up -d --wait",
    "db:push": "bun run --filter '@starter/db' push",
    "setup": "bun run db:up && bun run db:push"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

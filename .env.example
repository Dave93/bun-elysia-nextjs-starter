# PostgreSQL (docker compose up -d starts this one)
DATABASE_URL=postgres://starter:starter@localhost:5433/starter

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The origin the browser talks to. In development that is the Next.js app,
# which rewrites /api/* to the API.
BETTER_AUTH_URL=http://localhost:3000

# Where Next.js forwards /api/* (server side only)
API_URL=http://localhost:3001
API_PORT=3001
